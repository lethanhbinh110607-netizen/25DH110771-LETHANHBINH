@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Bài 4 - Layout bằng HTML5 Semantic Elements</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            display: grid;
            grid-template-columns: repeat(3, auto);
            gap: 40px;
            padding: 40px;
            justify-content: center;
        }

        
        .layout-box {
            width: 250px;
            height: 250px;
            border: 2px solid #5a6a8c;
            display: flex;
            flex-direction: column;
            background-color: white;
        }

        
        header, footer, nav {
            width: 100%;
            border: 1px solid #5a6a8c;
        }

        header {
            height: 20%;
        }

        nav {
            height: 10%;
        }

        footer {
            height: 20%;
        }

        
        .row {
            display: flex;
            flex: 1;
            width: 100%;
        }

        aside {
            width: 30%;
            border: 1px solid #5a6a8c;
        }

        main {
            flex: 1;
            border: 1px solid #5a6a8c;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }

        
        .main-col {
            flex: 1;
            display: flex;
            flex-direction: column;
            border: 1px solid #5a6a8c;
        }

        .sub-header {
            height: 20%;
            border-bottom: 2px solid #5a6a8c;
        }

        
        .circle {
            width: 40px;
            height: 40px;
            background: linear-gradient(135deg, #d3e18a, #a6b553);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            font-weight: bold;
            box-shadow: 2px 2px 5px rgba(0,0,0,0.3);
        }
    </style>
</head>
<body>

    
    <div class="layout-box">
        <header></header>
        <div class="row">
            <aside></aside>
            <main>
                <div class="circle">1</div>
            </main>
        </div>
    </div>

    
    <div class="layout-box">
        <header></header>
        <div class="row">
            <main>
                <div class="circle">2</div>
            </main>
            <aside></aside>
        </div>
    </div>

    
    <div class="layout-box">
        <header></header>
        <div class="row">
            <aside></aside>
            <main>
                <div class="circle">3</div>
            </main>
            <aside></aside>
        </div>
        <footer></footer>
    </div>

    
    <div class="layout-box">
        <header></header>
        <nav></nav>
        <div class="row">
            <aside></aside>
            <main>
                <div class="circle">4</div>
            </main>
        </div>
    </div>

    
    <div class="layout-box">
        <header></header>
        <div class="row">
            <div class="main-col">
                <div class="sub-header"></div>
                <main style="border: none;">
                    <div class="circle">5</div>
                </main>
            </div>
            <aside></aside>
        </div>
    </div>

    
    <div class="layout-box">
        <header></header>
        <div class="row">
            <aside></aside>
            <div class="main-col">
                <div class="sub-header"></div>
                <main style="border: none;">
                    <div class="circle">6</div>
                </main>
            </div>
            <aside></aside>
        </div>
        <footer></footer>
    </div>

</body>
</html>
