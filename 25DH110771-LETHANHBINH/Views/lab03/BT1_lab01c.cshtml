@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Bài tập 1 - Layout Table</title>
    <style>
        
        table {
            width: 700px;
            border-collapse: collapse; 
            margin: 20px auto;
        }

        td, th {
            border: 1px solid black;
            padding: 15px;
            vertical-align: top; 
        }

        .box {
            width: 40px;
            height: 50px;
            border: 1px solid black;
            display: inline-block;
            margin-top: 10px;
        }
    </style>
</head>
<body>

    <table>
        
        <tr>
            
            <td rowspan="3" style="width: 25%;">
                <p>danh sách<br>các mục<br>liên kết</p>
                <p>3421<br>6789<br>1122<br>9999</p>
            </td>

            
            <td colspan="2" style="height: 60px; text-align: center;">
                Logo
            </td>
        </tr>

        
        <tr>
            
            <td rowspan="2" style="width: 37.5%;">
                <p>Nội dung 1</p>
                <p>đẹp trai<br>số 1<br>thế giới</p>
                
                <div class="box"></div>
            </td>

            
            <td style="width: 37.5%;">
                <p>Nội dung 2</p>
                
                <ul style="list-style-type: circle; padding-left: 20px;">
                    <li>nnnn</li>
                    <li>aaaaa</li>
                    <li>nnnnn</li>
                    <li>qqqqq</li>
                </ul>
            </td>
        </tr>

        
        <tr>
            
            <td>
                <p>Nội dung 3</p>
                <p>~~~~~<br>~~~~~<br>~~~~~</p>
                
                <div class="box"></div>
            </td>
        </tr>
    </table>

</body>
</html>
