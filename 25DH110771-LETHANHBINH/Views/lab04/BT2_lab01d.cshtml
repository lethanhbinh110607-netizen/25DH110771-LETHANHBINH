@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Đăng nhập sinh viên</title>
</head>
<body>

    <h2>Thông tin đăng nhập sinh viên</h2>

    
    <form action="https://www.google.com" method="POST">
        <p>
            <label for="mssv">Mã số sinh viên:</label><br>
            <input type="text" id="mssv" name="mssv" value="25dhxxxxx">
        </p>

        <p>
            <label for="password">Mật khẩu:</label><br>
            <input type="password" id="password" name="password">
        </p>

        <p>
            <input type="checkbox" id="remember" name="remember">
            <label for="remember">Lưu thông tin đăng nhập.</label>
        </p>

        <p>
            <input type="submit" value="Đăng nhập">
        </p>
    </form>

    
    <p>
        Sử dụng thông tin đăng nhập do trường cấp, nếu quên mật khẩu thì nhấn vào
        <a href="repass.html">đây</a>.
    </p>

</body>
</html>
